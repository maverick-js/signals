{
  "name": "@maverick-js/signals",
  "description": "A lightweight (~1kB) library for creating reactive observables via functions.",
  "license": "MIT",
  "version": "6.0.0",
  "type": "module",
  "types": "dist/types/index.d.ts",
  "module": "dist/prod/index.js",
  "sideEffects": false,
  "files": [
    "dist/",
    "*.d.ts"
  ],
  "scripts": {
    "build": "pnpm types && vp pack",
    "format": "vp fmt",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:gc": "vp test tests/gc.test.ts",
    "test:gc:watch": "vp test watch tests/gc.test.ts",
    "bench:layers": "pnpm build && node bench/layers.js",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "release": "pnpm validate && standard-version && git push --follow-tags origin main && npm publish",
    "bench": "vp test bench --run",
    "bench:quick": "BENCH_QUICK=1 vp test bench --run",
    "bench:calibrate": "BENCH_CALIBRATE=1 vp test bench --run",
    "bench:baseline": "node bench/build-baseline.js",
    "bench:synthetic": "vp test bench --run bench/synthetic",
    "bench:graph": "vp test bench --run bench/graph",
    "bench:dom": "vp test bench --run bench/dom",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "types": "tsc -p tsconfig.build.json"
  },
  "contributors": [
    "Rahim Alwer <rahim.alwer@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maverick-js/signals.git"
  },
  "bugs": {
    "url": "https://github.com/maverick-js/signals/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@preact/signals-core": "^1.14.4",
    "@reactively/core": "^0.0.8",
    "@types/node": "^26.4.1",
    "cellx": "^2.4.0",
    "cli-table": "^0.3.11",
    "kleur": "^4.1.5",
    "oxc-minify": "^0.148.0",
    "publint": "^0.3.24",
    "s-js": "^0.4.9",
    "solid-js": "^1.9.15",
    "standard-version": "^9.5.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "test": "./dist/dev/index.js",
      "development": "./dist/dev/index.js",
      "default": "./dist/prod/index.js"
    },
    "./map": {
      "types": "./dist/types/map.d.ts",
      "test": "./dist/dev/map.js",
      "development": "./dist/dev/map.js",
      "default": "./dist/prod/map.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.9.0"
}
