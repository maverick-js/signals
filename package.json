{
  "name": "@maverick-js/signals",
  "description": "A lightweight (~1kB) library for creating reactive observables via functions.",
  "license": "MIT",
  "version": "6.0.0",
  "type": "module",
  "types": "dist/types/index.d.ts",
  "module": "dist/prod/index.js",
  "sideEffects": false,
  "files": [
    "dist/",
    "*.d.ts"
  ],
  "scripts": {
    "build": "rimraf dist && rollup -c && pnpm types",
    "types": "tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:gc": "vitest run tests/gc.test.ts",
    "test:gc:watch": "vitest watch tests/gc.test.ts",
    "bench:layers": "pnpm build && node bench/layers.js",
    "validate": "pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "release": "pnpm validate && standard-version && git push --follow-tags origin main && npm publish",
    "bench": "node --expose-gc bench/index.js",
    "bench:quick": "node --expose-gc bench/index.js --quick",
    "bench:calibrate": "node --expose-gc bench/index.js --calibrate",
    "bench:baseline": "node bench/build-baseline.js",
    "bench:synthetic": "node --expose-gc bench/synthetic.js",
    "bench:graph": "node --expose-gc bench/graph.js",
    "bench:dom": "node --expose-gc bench/dom.js",
    "format:check": "oxfmt --check",
    "lint": "oxlint"
  },
  "contributors": [
    "Rahim Alwer <rahim.alwer@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maverick-js/signals.git"
  },
  "bugs": {
    "url": "https://github.com/maverick-js/signals/issues"
  },
  "devDependencies": {
    "@preact/signals-core": "^1.14.4",
    "@reactively/core": "^0.0.8",
    "@types/node": "^26.4.1",
    "cellx": "^2.4.0",
    "cli-table": "^0.3.11",
    "esbuild": "^0.28.2",
    "kleur": "^4.1.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "s-js": "^0.4.9",
    "solid-js": "^1.9.15",
    "standard-version": "^9.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "test": "./dist/dev/index.js",
      "development": "./dist/dev/index.js",
      "default": "./dist/prod/index.js"
    },
    "./map": {
      "types": "./dist/types/map.d.ts",
      "test": "./dist/dev/map.js",
      "development": "./dist/dev/map.js",
      "default": "./dist/prod/map.js"
    },
    "./package.json": "./package.json"
  }
}
